# AI Food Agent — API Keys
# Copy file này thành .env và điền API keys

# === LLM Provider (chọn 1 hoặc cả 2) ===
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# === Weather (OpenWeatherMap - FREE) ===
# Đăng ký tại: https://openweathermap.org/
OPENWEATHERMAP_API_KEY=your-owm-key-here

# === Restaurant Search (Geoapify - FREE, ưu tiên) ===
# Đăng ký tại: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your-geoapify-key-here

# === Restaurant Search fallback (Google Places - cần Billing) ===
# Cần Google Cloud Project + enable Places API + Billing
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# === Nutrition (USDA FoodData Central - FREE) ===
# Đăng ký tại: https://fdc.nal.usda.gov/api-key-signup/
USDA_FDC_API_KEY=your-usda-fdc-key-here

# === Cấu hình mặc định ===
DEFAULT_LAT=21.0341
DEFAULT_LON=105.9072
DEFAULT_CITY=Gia Lâm, Hà Nội
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
